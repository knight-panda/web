{
  "styles": {
    "maxWidth": "89rem",
    "width": "100%",
    "backgroundColor": "#ffffff",
    "borderRadius": "1rem",
    "borderRadiusMobile": "0.5rem",
    "desktopAspectRatio": "3/1",
    "mobileAspectRatio": "2.5/1",
    "objectFit": "fill",
    "autoPlay": true,
    "slideDuration": 4000,
    "transitionDuration": "0.7s",
    "pauseOnHover": true,
    "showDots": true,
    "showArrows": true,
    "showShadow": true,
    "shadow": "0 12px 32px rgba(0,0,0,0.12)",
    "showBorder": false,
    "arrowSize": "3rem",
    "arrowIconSize": "1.1rem",
    "arrowBackground": "rgba(255,255,255,0.95)",
    "arrowColor": "#051B4E",
    "arrowBorderRadius": "50%",
    "dotSize": "0.65rem",
    "dotSizeMobile": "0.45rem",
    "dotGap": "0.4rem",
    "dotGapMobile": "0.2rem",
    "dotColor": "#e5e7eb",
    "activeDotColor": "#051B4E",
    "lazyLoad": true,
    "infiniteLoop": true,
    "enableSwipe": true,
    "desktopMargin": "0.5rem auto 1.5rem auto",
    "mobileMargin": "0.5rem auto 0.5rem auto",
    "desktopPaddingX": "1rem",
    "mobilePaddingX": "0.5rem"
  }
}