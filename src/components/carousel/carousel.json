{
  "styles": {
    "maxWidth": "89rem",
    "width": "100%",
    "backgroundColor": "#ffffff",
    "borderRadius": "1rem",
    "desktopAspectRatio": "3.2/1",
    "mobileAspectRatio": "3.2/1",
    "objectFit": "fill",
    "autoPlay": true,
    "slideDuration": 4000,
    "transitionDuration": "0.7s",
    "pauseOnHover": true,
    "showDots": true,
    "showArrows": true,
    "showShadow": true,
    "shadow": "0 12px 32px rgba(0,0,0,0.12)",
    "showBorder": false,
    "arrowSize": "3rem",
    "arrowIconSize": "1.1rem",
    "arrowBackground": "rgba(255,255,255,0.95)",
    "arrowColor": "#d97706",
    "arrowBorderRadius": "50%",
    "dotSize": "0.65rem",
    "dotGap": "0.4rem",
    "dotColor": "#e5e7eb",
    "activeDotColor": "#d97706",
    "lazyLoad": true,
    "infiniteLoop": true,
    "enableSwipe": true,
    "desktopMargin": "1rem auto 1.5rem auto",
    "mobileMargin": "0 auto 1rem auto"
  }
}